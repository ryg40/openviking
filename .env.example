# Copy this file to .env and fill in the values. .env is ignored by Git.
# A host override file is loaded through COMPOSE_FILE; see docs/host-configuration.md.

# Root API key of the server. Required; generate one with: openssl rand -hex 32
OPENVIKING_ROOT_API_KEY=
# Image to run. The default is a local build with the tag openviking:local.
OPENVIKING_IMAGE=openviking:local
# Public base URL that the server reports to clients (OAuth, MCP).
OPENVIKING_PUBLIC_BASE_URL=http://127.0.0.1:1933
# Host address for the published port. Keep loopback unless ingress needs more.
OPENVIKING_BIND=127.0.0.1
# Host port that maps to container port 1933.
OPENVIKING_PORT=1933
