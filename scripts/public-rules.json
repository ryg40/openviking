  "path_placeholders": [
    {
      "pattern": "<storage\\.workspace>/bot/logs/",
      "reason": "Runtime workspace placeholder, not a source directory."
    },
    {
      "pattern": "\\.env(?:\\.\\*)?",
      "reason": "Generated local environment file, never tracked."
    },
    {
      "pattern": "(?:\\./)?data(?:/.*)?",
      "reason": "Generated runtime state, never tracked."
    },
    {
      "pattern": "\\.local(?:/.*)?",
      "reason": "Ignored host override or local policy file."
    },
    {
      "pattern": "\\.git(?:/.*)?",
      "reason": "Git metadata made by clone and hook installation."
    },
    {
      "pattern": "(?:refs|topic|sync)/.*",
      "reason": "Git ref notation, not a repository file."
    },
    {
      "pattern": "(?:linux|type)/(?:amd64|arm64|docker)",
      "reason": "Platform or output notation, not a repository file."
    },
    {
      "pattern": "openviking/\\.git/",
      "reason": "Clone destination Git metadata."
    },
    {
      "pattern": "ov(?:cli)?\\.conf",
      "reason": "Runtime configuration basename."
    },
    {
      "pattern": "openviking/_version\\.py",
      "reason": "Version file generated during the build."
    },
    {
      "pattern": "(?:RUST|NODE|PYTHON)_IMAGE",
      "reason": "Build variable, not a path."
    },
    {
      "pattern": "\\.{1,2}",
      "reason": "Current or parent directory notation."
    },
    {
      "pattern": "\\.gitleaks(?:ignore|baseline)",
      "reason": "Forbidden policy filename used to explain a check."
    },
    {
      "pattern": "\\.env\\*|\\.venv|\\.pyc",
      "reason": "Ignored environment files or generated Python artifacts."
    },
    {
      "pattern": "\\.base\\.digest",
      "reason": "Image label suffix, not a repository path."
    },
    {
      "pattern": "(?:linux/(?:amd64|arm64))(?:,linux/(?:amd64|arm64))*",
      "reason": "Docker platform list."
    },
    {
      "pattern": "(?:registry|mirror)\\.example\\.(?:com|invalid)/.*",
      "reason": "Neutral registry placeholder."
    },
    {
      "pattern": "scripts/git-hooks/<hook>",
      "reason": "Placeholder for a hook name."
    },
    {
      "pattern": "(?:lib/)?python3\\.\\*|\\*\\.dist-info|target/",
      "reason": "Generated package or build artifact pattern."
    },
    {
      "pattern": "upstream/main",
      "reason": "Remote-tracking ref, not a source path."
    },
    {
      "pattern": "<git-common-dir>/scan-hooks/",
      "reason": "Placeholder for Git metadata directory."
    },
    {
      "pattern": "tests/test_\\*\\.sh",
      "reason": "Shell test glob; individual paths have their own checks."
    }
  ],
  "defaults": [
    {
      "name": "OPENVIKING_ROOT_API_KEY",
      "section": "Docker Compose (`compose.yaml`, set in `.env`):",
      "sources": [
        {
          "path": ".env.example",
          "pattern": "^OPENVIKING_ROOT_API_KEY=(.*)$"
        },
        {
          "path": "compose.yaml",
          "pattern": "\\$\\{OPENVIKING_ROOT_API_KEY:\\?[^}]+\\}"
        }
      ],
      "document": "None; required"
